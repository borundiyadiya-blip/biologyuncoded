<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }} — {{ site.description }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ (page.url or "/") | url | absUrl }}">

<meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ (page.url or "/") | url | absUrl }}">
<meta name="twitter:card" content="summary_large_image">

<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ '/feed.xml' }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">

<link rel="stylesheet" href="{{ '/css/style.css' }}">
</head>

<body>
<a class="skip" href="#main">Skip to content</a>

<header class="masthead">
  <div class="wrap masthead-inner">
    <a class="wordmark" href="{{ '/' }}">
      <span class="wordmark-name">Biology&nbsp;Uncoded</span>
      <span class="wordmark-tag">{{ site.description }}</span>
    </a>
    {% set here = page.url or "" %}
    <nav class="nav" aria-label="Main">
      <a href="{{ '/archive/' }}"{% if '/archive/' in here %} aria-current="page"{% endif %}>Archive</a>
      <a href="{{ '/topics/' }}"{% if '/topics/' in here %} aria-current="page"{% endif %}>Topics</a>
      <a href="{{ '/about/' }}"{% if '/about/' in here %} aria-current="page"{% endif %}>About</a>
      <a href="{{ '/feed.xml' }}">RSS</a>
    </nav>
  </div>
  <div class="acgt" aria-hidden="true"></div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="footer">
  <div class="acgt" aria-hidden="true"></div>
  <div class="wrap footer-inner">
    <p class="footer-by">Written by {{ site.author.name }}.</p>
    <p class="footer-meta">
      &copy; {{ site.startYear }}–{{ buildYear }} &middot;
      <a href="{{ '/feed.xml' }}">RSS</a>
      {%- if site.links.email %} &middot; <a href="mailto:{{ site.links.email }}">Email</a>{% endif -%}
      {%- if site.links.github %} &middot; <a href="{{ site.links.github }}">GitHub</a>{% endif -%}
      {%- if site.links.linkedin %} &middot; <a href="{{ site.links.linkedin }}">LinkedIn</a>{% endif -%}
    </p>
  </div>
</footer>

</body>
</html>
