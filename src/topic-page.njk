---
layout: layouts/base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: topic
permalink: "/topics/{{ topic.name | slugifyTag }}/index.html"
eleventyComputed:
  title: "{{ topic.name }}"
---
<section class="wrap page-head">
  <p class="eyebrow"><a href="{{ '/topics/' }}">Topics</a></p>
  <h1 class="page-title">{{ topic.name }}</h1>
  <p class="page-sub">{{ topic.count }} post{% if topic.count != 1 %}s{% endif %}.</p>
</section>

<section class="wrap">
  <ol class="postlist">
    {% for p in collections.posts %}
      {% if topic.name in p.data.tags %}
      <li class="postlist-item">
        <p class="eyebrow"><time datetime="{{ p.date | isoDate }}">{{ p.date | shortDate }}</time></p>
        <h2 class="postlist-title"><a href="{{ p.url }}">{{ p.data.title }}</a></h2>
        <p class="postlist-excerpt">{{ p.data.description or (p.templateContent | excerpt(190)) }}</p>
      </li>
      {% endif %}
    {% endfor %}
  </ol>
</section>
