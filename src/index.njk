---
layout: layouts/base.njk
pagination:
  data: collections.posts
  size: 12
  reverse: false
  alias: pagePosts
permalink: "{% if pagination.pageNumber == 0 %}/index.html{% else %}/page/{{ pagination.pageNumber + 1 }}/index.html{% endif %}"
---
{% if pagination.pageNumber == 0 %}
{% set lead = collections.posts[0] %}
<section class="lead wrap">
  <p class="eyebrow">Latest <span class="sep">/</span> <time datetime="{{ lead.date | isoDate }}">{{ lead.date | readableDate }}</time></p>
  <h1 class="lead-title"><a href="{{ lead.url }}">{{ lead.data.title }}</a></h1>
  <p class="lead-excerpt">{{ lead.data.description or (lead.templateContent | excerpt(320)) }}</p>
  <a class="readon" href="{{ lead.url }}">Read the post</a>
</section>
<div class="wrap-rule">{% include "partials/helix.njk" %}</div>
{% endif %}

<section class="wrap">
  {% if pagination.pageNumber == 0 %}
  <h2 class="section-label">More posts</h2>
  {% else %}
  {# Pages 2+ have no lead article, so without this they would ship no h1 at
     all — the document would start at h2. #}
  <h1 class="page-title">Posts</h1>
  <p class="page-sub">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</p>
  {% endif %}
  <ol class="postlist" reversed>
    {% for p in pagePosts %}
      {% if not (pagination.pageNumber == 0 and loop.index0 == 0) %}
      <li class="postlist-item">
        <p class="eyebrow"><time datetime="{{ p.date | isoDate }}">{{ p.date | shortDate }}</time></p>
        <h2 class="postlist-title"><a href="{{ p.url }}">{{ p.data.title }}</a></h2>
        <p class="postlist-excerpt">{{ p.data.description or (p.templateContent | excerpt(190)) }}</p>
      </li>
      {% endif %}
    {% endfor %}
  </ol>

  {% if pagination.pages.length > 1 %}
  <nav class="paginate" aria-label="Pagination">
    {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">&larr; Newer</a>{% endif %}
    <span class="paginate-count">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
    {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Older &rarr;</a>{% endif %}
  </nav>
  {% endif %}
</section>
