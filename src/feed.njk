---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
{%- set feedPosts = collections.posts | limit(25) -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ '/feed.xml' | url | absUrl }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | url | absUrl }}" rel="alternate" type="text/html"/>
  <updated>{{ feedPosts[0].date | isoDate }}</updated>
  <id>{{ '/' | url | absUrl }}</id>
  <author>
    <name>{{ site.author.name }}</name>
  </author>
{%- for p in feedPosts %}
  <entry>
    <title>{{ p.data.title }}</title>
    <link href="{{ p.url | url | absUrl }}" rel="alternate" type="text/html"/>
    <id>{{ p.url | url | absUrl }}</id>
    <updated>{{ p.date | isoDate }}</updated>
    <published>{{ p.date | isoDate }}</published>
    {%- if p.data.description %}
    <summary>{{ p.data.description }}</summary>
    {%- endif %}
    <content type="html">{{ p.templateContent | absoluteLinks(p.url) }}</content>
  </entry>
{%- endfor %}
</feed>
